{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-manifest.v1.schema.json",
  "title": "ProjectManifest",
  "description": "One map project (plan §2.1). Source of truth for the TypeScript types (frontend/src/lib/contracts.gen.ts) and for validation in mapgen and core-api (contracts/validate.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "slug", "title", "status", "view", "layers"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "$ref": "#/definitions/ProjectStatus" },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "view": { "$ref": "#/definitions/ViewSpec" },
    "place": {
      "description": "The one place a project is about (set by the quick-map builder), e.g. a parcel: the admin project workspace offers the analyses that run on this unit (process descriptors' `units`).",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "key"],
      "properties": {
        "unit": { "type": "string", "pattern": "^[a-z]+$", "description": "Unit id (app.units), e.g. parcel, town" },
        "key": { "type": "string", "minLength": 1, "description": "The place's unit_key in pub.units__<unit>" },
        "name": { "type": "string", "description": "Display name" }
      }
    },
    "layers": { "type": "array", "items": { "$ref": "#/definitions/LayerSpec" } },
    "notes": {
      "description": "Free-text to-do notes for placeholder projects, shown on the hub and in the viewer.",
      "type": "array",
      "items": { "type": "string" }
    },
    "charts": {
      "description": "D3 charts computed on the fly from the project's published data (GET /api/projects/{slug}/charts/{id}), shown in the viewer's Charts panel and in PDF reports.",
      "type": "array",
      "items": { "$ref": "#/definitions/ChartSpec" }
    }
  },
  "definitions": {
    "ChartSpec": {
      "title": "ChartSpec",
      "description": "One chart: an aggregate of a pub view computed by core-api (never free SQL). bar/donut: `category` with `agg` of `value` (count needs no value); histogram: bins of `value`; scatter: `x` against `y`; stats: a row of headline numbers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "data"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string" },
        "type": { "enum": ["bar", "donut", "histogram", "scatter", "stats"] },
        "layer": { "description": "Id of the map layer showing this data: hovering a mark highlights its features there.", "type": "string" },
        "scope": { "description": "Initial scope: the whole layer (all) or the features in the map view (view). The viewer can switch.", "enum": ["all", "view"] },
        "format": { "$ref": "#/definitions/ChartFormat" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collection"],
          "properties": {
            "collection": { "$ref": "#/definitions/Collection" },
            "category": { "type": "string" },
            "value": { "type": "string" },
            "agg": { "$ref": "#/definitions/ChartAgg" },
            "x": { "type": "string" },
            "y": { "type": "string" },
            "label": { "type": "string" },
            "bins": { "type": "integer", "minimum": 3, "maximum": 40 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
            "within": {
              "description": "Only features intersecting one place (a row of a pub.units__* view), e.g. the town of a map design.",
              "type": "object",
              "additionalProperties": false,
              "required": ["unit", "place"],
              "properties": { "unit": { "type": "string" }, "place": { "type": "string" } }
            },
            "stats": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "agg"],
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" },
                  "agg": { "$ref": "#/definitions/ChartAgg" },
                  "format": { "$ref": "#/definitions/ChartFormat" }
                }
              }
            }
          }
        }
      }
    },
    "ChartAgg": { "title": "ChartAgg", "enum": ["count", "sum", "avg", "median", "min", "max"] },
    "ChartFormat": { "title": "ChartFormat", "enum": ["number", "count", "currency", "percent", "acres", "sqmi", "years", "mw"] },
    "ProjectStatus": { "title": "ProjectStatus", "type": "string", "enum": ["stub", "draft", "ready"] },
    "LayerStatus": { "title": "LayerStatus", "type": "string", "enum": ["ready", "todo"] },
    "LngLat": {
      "title": "LngLat",
      "type": "array",
      "items": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "BBox": {
      "title": "BBox",
      "type": "array",
      "items": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 4,
      "maxItems": 4,
      "additionalItems": false
    },
    "ViewSpec": {
      "title": "ViewSpec",
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "zoom"],
      "properties": {
        "center": { "$ref": "#/definitions/LngLat" },
        "zoom": { "type": "number", "minimum": 0, "maximum": 22 },
        "bounds": { "anyOf": [{ "$ref": "#/definitions/BBox" }, { "type": "null" }] },
        "basemap": { "type": "string" }
      }
    },
    "LayerSpec": {
      "title": "LayerSpec",
      "description": "One visual layer. `source.type` selects the frontend adapter (src/lib/adapters.ts).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48 },
        "title": { "type": "string", "minLength": 1 },
        "group": { "type": "string" },
        "status": { "$ref": "#/definitions/LayerStatus" },
        "todo": { "type": ["string", "null"] },
        "visible": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "minzoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "maxzoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "source": { "$ref": "#/definitions/SourceSpec" },
        "style": { "$ref": "#/definitions/StyleSpec" },
        "legend": { "$ref": "#/definitions/LegendSpec" },
        "interaction": { "$ref": "#/definitions/InteractionSpec" },
        "controls": {
          "description": "UI controls bound to tiPG function arguments (source.params).",
          "type": "array",
          "items": { "$ref": "#/definitions/ParamControl" }
        },
        "attribution": { "type": "string" }
      }
    },
    "SourceSpec": {
      "title": "SourceSpec",
      "oneOf": [
        { "$ref": "#/definitions/TipgVectorSource" },
        { "$ref": "#/definitions/GeojsonUrlSource" },
        { "$ref": "#/definitions/RasterXyzSource" },
        { "$ref": "#/definitions/RasterCogSource" }
      ]
    },
    "Collection": {
      "title": "Collection",
      "description": "A tiPG collection id: a view or function in the pub schema.",
      "type": "string",
      "pattern": "^pub\\.[a-z0-9_]+$"
    },
    "FunctionParams": {
      "title": "FunctionParams",
      "type": "object",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "TipgVectorSource": {
      "title": "TipgVectorSource",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "collection"],
      "properties": {
        "type": { "const": "tipg-vector" },
        "collection": { "$ref": "#/definitions/Collection" },
        "tms": { "type": "string" },
        "params": { "$ref": "#/definitions/FunctionParams" },
        "properties": { "type": "array", "items": { "type": "string" } },
        "maxzoom": { "type": "number", "minimum": 0, "maximum": 24 }
      }
    },
    "GeojsonUrlSource": {
      "title": "GeojsonUrlSource",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "geojson-url" },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "RasterXyzSource": {
      "title": "RasterXyzSource",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tiles"],
      "properties": {
        "type": { "const": "raster-xyz" },
        "tiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tileSize": { "type": "integer", "enum": [256, 512] },
        "maxzoom": { "type": "number", "minimum": 0, "maximum": 24 }
      }
    },
    "RasterCogSource": {
      "title": "RasterCogSource",
      "description": "A COG in data/cog/, served by titiler through the proxy's /raster/<cog>/... route.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cog"],
      "properties": {
        "type": { "const": "raster-cog" },
        "cog": { "type": "string", "pattern": "^[a-z0-9_/-]+$" },
        "rescale": {
          "type": "array",
          "items": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false
        },
        "colormap": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "categories": {
          "description": "Classes of a categorical raster (soil groups, vegetation types): each pixel value gets its own colour, values not listed are transparent, and a click shows the label. Use instead of rescale/colormap.",
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "color"],
            "properties": {
              "value": { "type": "integer" },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "label": { "type": "string" }
            }
          }
        },
        "bidx": { "type": "integer", "minimum": 1 },
        "maxzoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "units": {
          "description": "Unit label for the pixel value shown when the map is clicked (titiler point query).",
          "type": "string"
        }
      }
    },
    "StyleSpec": {
      "title": "StyleSpec",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "layers"],
      "properties": {
        "kind": { "const": "maplibre" },
        "layers": { "type": "array", "items": { "$ref": "#/definitions/StyleFragment" } }
      }
    },
    "StyleFragment": {
      "title": "StyleFragment",
      "description": "A MapLibre style layer minus id/source/source-layer, which the adapter injects. Checked in full by the MapLibre style-spec validator (make validate).",
      "tsType": "MapLibreStyleFragment",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["fill", "line", "circle", "symbol", "heatmap", "fill-extrusion", "raster", "hillshade"] },
        "id": false,
        "source": false,
        "source-layer": false
      }
    },
    "LegendSpec": {
      "title": "LegendSpec",
      "oneOf": [
        {
          "title": "CategoricalLegend",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "categorical" },
            "title": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "color"],
                "properties": {
                  "label": { "type": "string" },
                  "color": { "type": "string" },
                  "pattern": { "type": "string", "pattern": "^pat:(diag|back|cross|horiz|dots):[0-9a-f]{6}$", "description": "Fill pattern of this class (frontend/src/lib/patterns.ts), as used in the style's fill-pattern" },
                  "outline": { "enum": ["solid", "dashed"], "description": "Outline style of this class, when outlines tell classes apart" }
                }
              }
            }
          }
        },
        {
          "title": "GradientLegend",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "stops"],
          "properties": {
            "type": { "const": "gradient" },
            "title": { "type": "string" },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "color"],
                "properties": { "value": { "type": "string" }, "color": { "type": "string" } }
              }
            }
          }
        },
        {
          "title": "SingleLegend",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "color"],
          "properties": {
            "type": { "const": "single" },
            "label": { "type": "string" },
            "color": { "type": "string" }
          }
        },
        {
          "title": "NoLegend",
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "none" } }
        }
      ]
    },
    "InteractionSpec": {
      "title": "InteractionSpec",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "popup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template"],
          "properties": { "template": { "type": "string" } }
        },
        "inspect": { "type": "boolean" }
      }
    },
    "ParamControl": {
      "title": "ParamControl",
      "type": "object",
      "additionalProperties": false,
      "required": ["param", "label", "type", "min", "max"],
      "properties": {
        "param": { "type": "string" },
        "label": { "type": "string" },
        "type": { "const": "range" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" }
      }
    }
  }
}
