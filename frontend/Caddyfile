{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change; everything else is revalidated.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /_app/immutable/*
	header @mutable Cache-Control "no-cache"

	# SPA: unknown paths (e.g. /p/world-overview) get the app shell.
	try_files {path} /200.html
	file_server
}
