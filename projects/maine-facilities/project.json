    {
      "id": "cell-towers",
      "title": "Cellular towers",
      "group": "Communications",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_facilities__cell_towers",
        "properties": [
          "licensee",
          "structure",
          "height_m",
          "callsign",
          "city"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "circle",
            "paint": {
              "circle-color": "#7f7f7f",
              "circle-radius": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                7,
                2,
                14,
                6
              ],
              "circle-stroke-color": "#ffffff",
              "circle-stroke-width": 0.8
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Cell tower",
        "items": [
          {
            "label": "Cell tower",
            "color": "#7f7f7f"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{licensee}: {structure}, {height_m} m ({callsign})"
        },
        "inspect": true
      },
      "attribution": "HIFLD Open (final snapshot, August 2025)",
      "visible": false
