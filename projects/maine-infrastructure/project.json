{
  "manifestVersion": 1,
  "slug": "maine-infrastructure",
  "status": "ready",
  "title": "Maine Infrastructure",
  "description": "E911 road centerlines and address points, and wind turbines (US Wind Turbine Database). Local roads appear from zoom 12 and address points from zoom 14 (798,422 points).",
  "tags": [
    "maine",
    "roads",
    "addresses",
    "energy"
  ],
  "view": {
    "center": [
      -68.975,
      45.19
    ],
    "zoom": 6.3,
    "bounds": [
      -71.15,
      42.85,
      -66.8,
      47.53
    ],
    "basemap": "positron"
  },
  "layers": [
    {
      "id": "roads-local",
      "title": "Local and other roads",
      "group": "Roads",
      "minzoom": 12,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_infrastructure__roads_local"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#8c8c8c",
              "line-width": 0.8
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#8c8c8c",
        "label": "Local road"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{name} ({class}, {town})"
        }
      },
      "attribution": "Maine E911"
    },
    {
      "id": "roads-secondary",
      "title": "Secondary roads",
      "group": "Roads",
      "minzoom": 9,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_infrastructure__roads_secondary"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#e6a100",
              "line-width": 1.6
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#e6a100",
        "label": "Secondary"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{name} ({town})"
        }
      },
      "attribution": "Maine E911"
    },
    {
      "id": "roads-primary",
      "title": "Primary roads and ramps",
      "group": "Roads",
      "minzoom": 5,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_infrastructure__roads_primary"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#d95f02",
              "line-width": 2.4
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#d95f02",
        "label": "Primary"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{name}"
        }
      },
      "attribution": "Maine E911"
    },
    {
      "id": "addresses",
      "title": "Address points (E911)",
      "group": "Addresses",
      "minzoom": 14,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_infrastructure__addresses"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "circle",
            "paint": {
              "circle-color": "#525252",
              "circle-radius": 2.5,
              "circle-stroke-color": "#fff",
              "circle-stroke-width": 1
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#525252",
        "label": "Address point"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{address}, {town}"
        }
      },
      "attribution": "Maine E911"
    },
    {
      "id": "wind-turbines",
      "title": "Wind turbines",
      "group": "Energy",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_infrastructure__wind_turbines"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "symbol",
            "layout": {
              "icon-image": "poi:windmill:5e3c99",
              "icon-size": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                6,
                0.45,
                10,
                0.65,
                14,
                0.9
              ],
              "icon-allow-overlap": true,
              "icon-ignore-placement": true
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#5e3c99",
        "label": "Turbine"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{project} ({year}): {capacity_kw} kW"
        }
      },
      "attribution": "U.S. Wind Turbine Database (USGS, LBNL, ACP)"
    },
    {
      "id": "maine-boundary",
      "title": "Maine boundary",
      "group": "Boundaries",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.units__state",
        "properties": [
          "name"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#1d3557",
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                5,
                1.2,
                12,
                2.2
              ],
              "line-opacity": 0.85
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#1d3557",
        "label": "Maine"
      },
      "interaction": {
        "inspect": false
      },
      "attribution": "U.S. Census Bureau: TIGER/Line 2024",
      "visible": true
    }
  ]
}
