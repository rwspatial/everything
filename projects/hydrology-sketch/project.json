{
  "manifestVersion": 1,
  "slug": "hydrology-sketch",
  "title": "Hydrology Sketch",
  "status": "draft",
  "description": "Rivers and lakes of the world, with a rank filter that runs in PostGIS. Natural Earth 1:10m.",
  "tags": [
    "hydrology",
    "natural-earth"
  ],
  "view": {
    "center": [
      -95,
      45
    ],
    "zoom": 2.6,
    "basemap": "positron"
  },
  "layers": [
    {
      "id": "lakes",
      "title": "Lakes (GeoJSON)",
      "group": "Water bodies",
      "source": {
        "type": "tipg-geojson",
        "collection": "pub.hydrology_sketch__lakes",
        "properties": [
          "name",
          "scalerank",
          "featurecla"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": "#4a90c2",
              "fill-opacity": 0.7
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#2c6e9e",
              "line-width": 0.5
            }
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{name}"
        },
        "inspect": true
      }
    },
    {
      "id": "rivers-all",
      "title": "All rivers (default style)",
      "group": "Rivers",
      "visible": false,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.hydrology_sketch__rivers"
      },
      "interaction": {
        "inspect": true
      }
    },
    {
      "id": "rivers-by-rank",
      "title": "Rivers by rank (PostGIS function)",
      "group": "Rivers",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.hydrology_sketch__rivers_by_rank",
        "params": {
          "max_scalerank": 5
        }
      },
      "controls": [
        {
          "param": "max_scalerank",
          "label": "Max rank",
          "type": "range",
          "min": 0,
          "max": 12,
          "step": 1
        }
      ],
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#1f78b4",
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "get",
                  "scalerank"
                ],
                0,
                2.4,
                12,
                0.5
              ]
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#1f78b4",
        "label": "River (thicker = more important)"
      },
      "interaction": {
        "popup": {
          "template": "{name} (rank {scalerank})"
        },
        "inspect": true
      }
    }
  ]
}
