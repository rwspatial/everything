{
  "manifestVersion": 1,
  "slug": "maine-lands",
  "status": "draft",
  "title": "Maine Lands",
  "description": "Lands in which the Bureau of Parks and Lands holds an interest, USDA plant hardiness zones (2023), and the underlying extreme-minimum-temperature grid served as a Cloud-Optimized GeoTIFF.",
  "tags": [
    "maine",
    "public lands",
    "climate"
  ],
  "view": {
    "center": [
      -68.975,
      45.19
    ],
    "zoom": 6.3,
    "bounds": [
      -71.15,
      42.85,
      -66.8,
      47.53
    ],
    "basemap": "positron"
  },
  "layers": [
    {
      "id": "conserved-lands",
      "title": "Conserved lands (all holders)",
      "group": "Conservation",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_lands__conserved_lands",
        "properties": [
          "name",
          "designation",
          "holder_type",
          "holder",
          "interest",
          "public_access",
          "access_notes",
          "acres",
          "acq_year"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "match",
                [
                  "get",
                  "holder_type"
                ],
                "State",
                "#1b7837",
                "Federal",
                "#5aae61",
                "Municipal",
                "#a6dba0",
                "Private",
                "#762a83",
                "Other",
                "#c2a5cf",
                "#c2a5cf"
              ],
              "fill-opacity": [
                "case",
                [
                  "==",
                  [
                    "get",
                    "interest"
                  ],
                  "easement"
                ],
                0.3,
                0.6
              ]
            }
          },
          {
            "type": "line",
            "minzoom": 9,
            "paint": {
              "line-color": [
                "match",
                [
                  "get",
                  "holder_type"
                ],
                "State",
                "#1b7837",
                "Federal",
                "#5aae61",
                "Municipal",
                "#a6dba0",
                "Private",
                "#762a83",
                "Other",
                "#c2a5cf",
                "#c2a5cf"
              ],
              "line-width": 0.6
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Holder (paler: conservation easement)",
        "items": [
          {
            "label": "State",
            "color": "#1b7837"
          },
          {
            "label": "Federal",
            "color": "#5aae61"
          },
          {
            "label": "Municipal",
            "color": "#a6dba0"
          },
          {
            "label": "Private (land trusts, others)",
            "color": "#762a83"
          },
          {
            "label": "Other",
            "color": "#c2a5cf"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{name} ({holder}, {interest}): {acres} acres; public access: {public_access}"
        },
        "inspect": true
      },
      "attribution": "Maine GeoLibrary, Maine Conserved Lands",
      "visible": false
    },
    {
      "id": "min-temp",
      "title": "Extreme minimum temperature (grid)",
      "group": "Climate",
      "source": {
        "type": "raster-cog",
        "cog": "maine/phzm_2023_min_temp",
        "rescale": [
          -35,
          5
        ],
        "colormap": "rdylbu_r",
        "units": "°F",
        "maxzoom": 12
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "raster",
            "paint": {
              "raster-opacity": 0.75,
              "raster-resampling": "linear"
            }
          }
        ]
      },
      "legend": {
        "type": "gradient",
        "title": "Avg. annual extreme minimum (°F)",
        "stops": [
          {
            "value": "-35",
            "color": "#313695"
          },
          {
            "value": "-25",
            "color": "#4575b4"
          },
          {
            "value": "-15",
            "color": "#abd9e9"
          },
          {
            "value": "-5",
            "color": "#fee090"
          },
          {
            "value": "5",
            "color": "#d73027"
          }
        ]
      },
      "interaction": {
        "inspect": true
      },
      "attribution": "USDA PHZM 2023; PRISM, Oregon State University"
    },
    {
      "id": "hardiness",
      "title": "Plant hardiness zones (2023)",
      "group": "Climate",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_lands__hardiness_zones"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "match",
                [
                  "get",
                  "zone"
                ],
                "3a",
                "#5b6bd1",
                "3b",
                "#6f8ee0",
                "4a",
                "#6ec2d8",
                "4b",
                "#7fd1a0",
                "5a",
                "#b7e07a",
                "5b",
                "#e4e35c",
                "6a",
                "#f6c64a",
                "6b",
                "#f39c3c",
                "7a",
                "#e8713a",
                "#9e9e9e"
              ],
              "fill-opacity": 0.45
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#ffffff",
              "line-width": 0.3
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "USDA zone",
        "items": [
          {
            "label": "3a",
            "color": "#5b6bd1"
          },
          {
            "label": "3b",
            "color": "#6f8ee0"
          },
          {
            "label": "4a",
            "color": "#6ec2d8"
          },
          {
            "label": "4b",
            "color": "#7fd1a0"
          },
          {
            "label": "5a",
            "color": "#b7e07a"
          },
          {
            "label": "5b",
            "color": "#e4e35c"
          },
          {
            "label": "6a",
            "color": "#f6c64a"
          },
          {
            "label": "6b",
            "color": "#f39c3c"
          },
          {
            "label": "7a",
            "color": "#e8713a"
          }
        ]
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "Zone {zone}: {min_temp_range_f} °F"
        }
      },
      "attribution": "USDA PHZM 2023; PRISM, Oregon State University",
      "visible": false
    },
    {
      "id": "public-lands",
      "title": "Public lands (BPL interests)",
      "group": "Lands",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_lands__public_lands"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "match",
                [
                  "get",
                  "designation"
                ],
                "Public Land",
                "#1b7837",
                "State Park",
                "#5aae61",
                "State Wildlife Management Area",
                "#a6dba0",
                "Coastal Island",
                "#80cdc1",
                "Easement",
                "#c2a5cf",
                "#bababa"
              ],
              "fill-opacity": 0.65
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#1b4d1b",
              "line-width": 0.4
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Designation",
        "items": [
          {
            "label": "Public Land",
            "color": "#1b7837"
          },
          {
            "label": "State Park",
            "color": "#5aae61"
          },
          {
            "label": "State Wildlife Management Area",
            "color": "#a6dba0"
          },
          {
            "label": "Coastal Island",
            "color": "#80cdc1"
          },
          {
            "label": "Easement",
            "color": "#c2a5cf"
          },
          {
            "label": "Other",
            "color": "#bababa"
          }
        ]
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{parcel_name} ({designation}), {acres} acres"
        }
      },
      "attribution": "Maine Bureau of Parks and Lands"
    },
    {
      "id": "ntd-trails",
      "title": "Trails (USGS National Digital Trails)",
      "group": "Recreation",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_lands__ntd_trails",
        "properties": [
          "name",
          "trail_type",
          "miles",
          "hiking",
          "biking",
          "xc_ski",
          "snowmobile",
          "maintainer"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": [
                "match",
                [
                  "get",
                  "trail_type"
                ],
                "Snow Trail",
                "#3182bd",
                "#a63603"
              ],
              "line-width": 1.4,
              "line-dasharray": [
                2,
                1
              ]
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Trails (USGS)",
        "items": [
          {
            "label": "Hiking / multi-use trail",
            "color": "#a63603"
          },
          {
            "label": "Snow trail",
            "color": "#3182bd"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{name} ({trail_type}, {miles} mi): hiking {hiking}, biking {biking}, snowmobile {snowmobile}"
        },
        "inspect": true
      },
      "attribution": "USGS The National Map, National Transportation Dataset",
      "visible": false
    },
    {
      "id": "parcels",
      "title": "Tax parcels",
      "group": "Boundaries",
      "minzoom": 13,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_lands__parcels",
        "properties": [
          "area",
          "town",
          "map_lot",
          "acres",
          "label"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": "#b07d2b",
              "fill-opacity": 0.06
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#b07d2b",
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                13,
                0.5,
                17,
                1.5
              ]
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Parcels (zoom in to see)",
        "items": [
          {
            "label": "Tax parcel",
            "color": "#b07d2b"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{label}"
        },
        "inspect": true
      },
      "attribution": "Maine GeoLibrary (MEGIS) parcels; Maine Revenue Services (Unorganized Territory)",
      "visible": false
    },
    {
      "id": "town-boundaries",
      "title": "Town and township boundaries",
      "group": "Boundaries",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_lands__town_boundaries",
        "properties": [
          "town",
          "county"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#555555",
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                7,
                0.4,
                12,
                1.2
              ],
              "line-dasharray": [
                4,
                2
              ]
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Boundaries",
        "items": [
          {
            "label": "Town / township line",
            "color": "#555555"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{town}, {county} County"
        },
        "inspect": true
      },
      "attribution": "Maine GeoLibrary (MEGIS)",
      "visible": false
    },
    {
      "id": "maine-boundary",
      "title": "Maine boundary",
      "group": "Boundaries",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.units__state",
        "properties": [
          "name"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#1d3557",
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                5,
                1.2,
                12,
                2.2
              ],
              "line-opacity": 0.85
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#1d3557",
        "label": "Maine"
      },
      "interaction": {
        "inspect": false
      },
      "attribution": "U.S. Census Bureau: TIGER/Line 2024",
      "visible": true
