{
  "manifestVersion": 1,
  "slug": "maine-places",
  "title": "Maine Places & Buildings",
  "status": "ready",
  "description": "Points of interest and building footprints across Maine from Overture Maps (OpenStreetMap, Microsoft, Google, Meta and partner data). Zoom in for buildings.",
  "tags": [
    "maine",
    "places",
    "buildings",
    "overture"
  ],
  "view": {
    "center": [
      -68.975,
      45.19
    ],
    "zoom": 6.3,
    "bounds": [
      -71.15,
      42.85,
      -66.8,
      47.53
    ],
    "basemap": "positron"
  },
  "layers": [
    {
      "id": "settlements",
      "title": "Settlements (built-up areas)",
      "group": "Built environment",
      "minzoom": 5,
      "maxzoom": 13,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_places__settlements",
        "properties": [
          "town",
          "county",
          "buildings",
          "acres",
          "size_class",
          "source"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": "#f2a93b",
              "fill-opacity": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                5,
                0.85,
                12,
                0.5
              ]
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": [
                "match",
                [
                  "get",
                  "source"
                ],
                "edited",
                "#7a3e00",
                "#c47f12"
              ],
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                7,
                [
                  "match",
                  [
                    "get",
                    "source"
                  ],
                  "edited",
                  0.8,
                  0.3
                ],
                12,
                [
                  "match",
                  [
                    "get",
                    "source"
                  ],
                  "edited",
                  2.2,
                  1
                ]
              ],
              "line-opacity": 0.8
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#f2a93b",
        "label": "Built-up area (clustered buildings)"
      },
      "interaction": {
        "popup": {
          "template": "{size_class}, {town}: {buildings} buildings on {acres} acres ({source} outline)"
        },
        "inspect": true
      },
      "attribution": "Built-up areas derived from Overture Maps buildings (DBSCAN 45 m wall to wall; at least 10 buildings; small holes filled)",
      "visible": true
    },
    {
      "id": "buildings",
      "title": "Buildings by type",
      "group": "Built environment",
      "minzoom": 13,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_places__buildings",
        "properties": [
          "name",
          "category",
          "subtype",
          "class",
          "height_m",
          "num_floors"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "match",
                [
                  "get",
                  "category"
                ],
                "Residential",
                "#2a78d6",
                "Commercial",
                "#eb6834",
                "Agricultural",
                "#1baf7a",
                "Education",
                "#eda100",
                "Medical",
                "#e87ba4",
                "Civic & religious",
                "#008300",
                "Industrial & service",
                "#4a3aa7",
                "Other",
                "#9aa0a6",
                "#d9dcdf"
              ],
              "fill-opacity": 0.85
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#5f6b73",
              "line-width": 0.3,
              "line-opacity": 0.6
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Building type (Overture subtype)",
        "items": [
          {
            "label": "Residential",
            "color": "#2a78d6"
          },
          {
            "label": "Commercial",
            "color": "#eb6834"
          },
          {
            "label": "Agricultural",
            "color": "#1baf7a"
          },
          {
            "label": "Education",
            "color": "#eda100"
          },
          {
            "label": "Medical",
            "color": "#e87ba4"
          },
          {
            "label": "Civic & religious",
            "color": "#008300"
          },
          {
            "label": "Industrial & service",
            "color": "#4a3aa7"
          },
          {
            "label": "Other",
            "color": "#9aa0a6"
          },
          {
            "label": "Unknown (not tagged)",
            "color": "#d9dcdf"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{name} {class} ({category})"
        },
        "inspect": true
      },
      "attribution": "© OpenStreetMap contributors, Overture Maps Foundation"
    },
    {
      "id": "places",
      "title": "Places",
      "group": "Points of interest",
      "minzoom": 12,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_places__places",
        "properties": [
          "name",
          "category",
          "detail",
          "address",
          "locality",
          "website",
          "confidence"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "circle",
            "paint": {
              "circle-color": [
                "match",
                [
                  "get",
                  "category"
                ],
                "services_and_business",
                "#0072B2",
                "shopping",
                "#E69F00",
                "health_care",
                "#D55E00",
                "food_and_drink",
                "#CC79A7",
                "community_and_government",
                "#009E73",
                "lifestyle_services",
                "#56B4E9",
                "travel_and_transportation",
                "#882255",
                "sports_and_recreation",
                "#44AA99",
                "lodging",
                "#999933",
                "cultural_and_historic",
                "#AA4499",
                "#9e9e9e"
              ],
              "circle-radius": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                12,
                1.5,
                16,
                3
              ],
              "circle-stroke-color": "#ffffff",
              "circle-stroke-width": 0.4
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Category",
        "items": [
          {
            "label": "Services and business",
            "color": "#0072B2"
          },
          {
            "label": "Shopping",
            "color": "#E69F00"
          },
          {
            "label": "Health care",
            "color": "#D55E00"
          },
          {
            "label": "Food and drink",
            "color": "#CC79A7"
          },
          {
            "label": "Community and government",
            "color": "#009E73"
          },
          {
            "label": "Lifestyle services",
            "color": "#56B4E9"
          },
          {
            "label": "Travel and transportation",
            "color": "#882255"
          },
          {
            "label": "Sports and recreation",
            "color": "#44AA99"
          },
          {
            "label": "Lodging",
            "color": "#999933"
          },
          {
            "label": "Cultural and historic",
            "color": "#AA4499"
          },
          {
            "label": "Other",
            "color": "#9e9e9e"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{name}: {detail}, {address} {locality}"
        },
        "inspect": true
      },
      "attribution": "Overture Maps Foundation"
    },
    {
      "id": "maine-boundary",
      "title": "Maine boundary",
      "group": "Boundaries",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.units__state",
        "properties": [
          "name"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#1d3557",
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                5,
                1.2,
                12,
                2.2
              ],
              "line-opacity": 0.85
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#1d3557",
        "label": "Maine"
      },
      "interaction": {
        "inspect": false
      },
      "attribution": "U.S. Census Bureau: TIGER/Line 2024",
      "visible": true
    }
  ],
  "charts": [
    {
      "id": "settlements-glance",
      "title": "Settlements",
      "type": "stats",
      "data": {
        "collection": "pub.maine_places__settlements",
        "stats": [
          {
            "label": "Built-up areas",
            "agg": "count",
            "format": "count"
          },
          {
            "label": "Buildings in them",
            "value": "buildings",
            "agg": "sum",
            "format": "count"
          },
          {
            "label": "Land they cover",
            "value": "acres",
            "agg": "sum",
            "format": "acres"
          }
        ]
      }
    },
    {
      "id": "settlements-by-size",
      "title": "Settlements by size",
      "type": "donut",
      "layer": "settlements",
      "format": "count",
      "data": {
        "collection": "pub.maine_places__settlements",
        "category": "size_class"
      }
    },
    {
      "id": "largest-settlements",
      "title": "Buildings in built-up areas, by town",
      "type": "bar",
      "layer": "settlements",
      "format": "count",
      "data": {
        "collection": "pub.maine_places__settlements",
        "category": "town",
        "value": "buildings",
        "agg": "sum",
        "limit": 12
      }
    }
  ]
}
