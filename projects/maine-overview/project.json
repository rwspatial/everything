{
  "manifestVersion": 1,
  "slug": "maine-overview",
  "title": "Maine Overview",
  "status": "ready",
  "description": "Median household income, poverty and more for Maine towns, census tracts and counties (ACS 2020-2024 5-year estimates on TIGER/Line 2024 boundaries).",
  "tags": [
    "maine",
    "demographics",
    "census"
  ],
  "view": {
    "center": [
      -69.25,
      45.3
    ],
    "zoom": 6.3,
    "basemap": "positron"
  },
  "layers": [
    {
      "id": "blocks-density",
      "title": "Population density by census block (2020)",
      "group": "Demographics",
      "visible": false,
      "minzoom": 9,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_overview__blocks",
        "properties": [
          "name",
          "pop",
          "housing_units",
          "vacant_units",
          "pop_per_sq_mi"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "filter": [
              ">",
              [
                "coalesce",
                [
                  "get",
                  "pop"
                ],
                0
              ],
              0
            ],
            "paint": {
              "fill-color": [
                "step",
                [
                  "coalesce",
                  [
                    "get",
                    "pop_per_sq_mi"
                  ],
                  0
                ],
                "#ffffcc",
                50,
                "#c7e9b4",
                250,
                "#7fcdbb",
                1000,
                "#41b6c4",
                5000,
                "#2c7fb8",
                10000,
                "#253494"
              ],
              "fill-opacity": 0.75
            }
          },
          {
            "type": "line",
            "minzoom": 12,
            "paint": {
              "line-color": "#7f7f7f",
              "line-width": 0.2
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "People per square mile of land (2020 Census; empty blocks not shaded)",
        "items": [
          {
            "label": "under 50",
            "color": "#ffffcc"
          },
          {
            "label": "50–250",
            "color": "#c7e9b4"
          },
          {
            "label": "250–1,000",
            "color": "#7fcdbb"
          },
          {
            "label": "1,000–5,000",
            "color": "#41b6c4"
          },
          {
            "label": "5,000–10,000",
            "color": "#2c7fb8"
          },
          {
            "label": "10,000 and over",
            "color": "#253494"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{name}: {pop} people, {housing_units} housing units ({vacant_units} vacant), {pop_per_sq_mi} per sq mi"
        },
        "inspect": true
      },
      "attribution": "U.S. Census Bureau: 2020 Census DHC, TIGER/Line 2024"
    },
    {
      "id": "bg-poverty",
      "title": "Poverty rate by block group",
      "group": "Demographics",
      "visible": false,
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_overview__blockgroups",
        "properties": [
          "name",
          "county",
          "pop",
          "median_hh_income",
          "median_hh_income_moe",
          "median_home_value",
          "median_age",
          "poverty_pct"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "case",
                [
                  "==",
                  [
                    "get",
                    "poverty_pct"
                  ],
                  null
                ],
                "#d9d9d9",
                [
                  "step",
                  [
                    "get",
                    "poverty_pct"
                  ],
                  "#fef0d9",
                  3.6,
                  "#fdcc8a",
                  6.9,
                  "#fc8d59",
                  10.9,
                  "#e34a33",
                  17.1,
                  "#b30000"
                ]
              ],
              "fill-opacity": 0.8
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#ffffff",
              "line-width": 0.3
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "People below the poverty line (block group quintiles)",
        "items": [
          {
            "label": "under 3.6 %",
            "color": "#fef0d9"
          },
          {
            "label": "3.6–6.9 %",
            "color": "#fdcc8a"
          },
          {
            "label": "6.9–10.9 %",
            "color": "#fc8d59"
          },
          {
            "label": "10.9–17.1 %",
            "color": "#e34a33"
          },
          {
            "label": "17.1 % and over",
            "color": "#b30000"
          },
          {
            "label": "suppressed",
            "color": "#d9d9d9"
          }
        ]
      },
      "interaction": {
        "popup": {
          "template": "{name}, {county}: {poverty_pct} % below the poverty line"
        },
        "inspect": true
      },
      "attribution": "U.S. Census Bureau: ACS 2020-2024 5-year, TIGER/Line 2024"
    },
