          },
          {
            "type": "line",
            "minzoom": 12,
            "paint": {
              "line-color": [
                "match",
                [
                  "get",
                  "hazard"
                ],
                "coastal high hazard",
                "#7b3294",
                "floodway",
                "#08306b",
                "1% annual chance",
                "#2171b5",
                "0.2% annual chance",
                "#9ecae1",
                "undetermined",
                "#bdbdbd",
                "#bdbdbd"
              ],
              "line-width": 0.5
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Flood hazard (FEMA zone)",
        "items": [
          {
            "label": "Coastal high hazard (VE, V)",
            "color": "#7b3294"
          },
          {
            "label": "Regulatory floodway",
            "color": "#08306b"
          },
          {
            "label": "1% annual chance, the 100-year flood (A, AE, AO, AH)",
            "color": "#2171b5"
          },
          {
            "label": "0.2% annual chance, 500-year (shaded X)",
