        "type": "tipg-vector",
        "collection": "pub.maine_water__flood_zones",
        "properties": [
          "zone",
          "subtype",
          "hazard",
          "base_flood_elev_ft",
          "v_datum",
          "dfirm_id"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "match",
                [
                  "get",
                  "hazard"
                ],
                "coastal high hazard",
                "#7b3294",
                "floodway",
                "#08306b",
                "1% annual chance",
                "#2171b5",
                "0.2% annual chance",
                "#9ecae1",
