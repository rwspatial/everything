{
  "manifestVersion": 1,
  "slug": "maine-coast",
  "status": "ready",
  "title": "Maine Coast",
  "description": "Shellfish growing areas and NSSP classifications, aquaculture leases and LPA sites, and boat launches. Shellfish classifications are the 2022 NSSP edition, NOT real-time open/closed status. Check Maine DMR closure notices before harvesting.",
  "tags": [
    "maine",
    "coast",
    "shellfish",
    "aquaculture"
  ],
  "view": {
    "center": [
      -68.975,
      45.19
    ],
    "zoom": 6.3,
    "bounds": [
      -71.15,
      42.85,
      -66.8,
      47.53
    ],
    "basemap": "positron"
  },
  "layers": [
    {
      "id": "growing-areas",
      "title": "Shellfish growing areas",
      "group": "Shellfish",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_coast__growing_areas"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#4d4d4d",
              "line-width": 1,
              "line-dasharray": [
                2,
                2
              ]
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#4d4d4d",
        "label": "Growing-area boundary"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "Growing area {label}"
        }
      },
      "attribution": "Maine DMR"
    },
    {
      "id": "shellfish-classes",
      "title": "Shellfish classifications (2022, not real-time)",
      "group": "Shellfish",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_coast__shellfish_classes"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "match",
                [
                  "get",
                  "classification"
                ],
                "Approved",
                "#1a9850",
                "Conditionally approved",
                "#91cf60",
                "Conditionally restricted",
                "#fee08b",
                "Restricted",
                "#fc8d59",
                "Prohibited",
                "#d73027",
                "#9e9e9e"
              ],
              "fill-opacity": 0.6
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#ffffff",
              "line-width": 0.3
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "NSSP classification",
        "items": [
          {
            "label": "Approved",
            "color": "#1a9850"
          },
          {
            "label": "Conditionally approved",
            "color": "#91cf60"
          },
          {
            "label": "Conditionally restricted",
            "color": "#fee08b"
          },
          {
            "label": "Restricted",
            "color": "#fc8d59"
          },
          {
            "label": "Prohibited",
            "color": "#d73027"
          }
        ]
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{classification} ({growing_area} {section})"
        }
      },
      "attribution": "Maine DMR"
    },
    {
      "id": "aquaculture-leases",
      "title": "Aquaculture leases",
      "group": "Aquaculture",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_coast__aquaculture_leases"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "fill",
            "paint": {
              "fill-color": [
                "match",
                [
                  "get",
                  "status"
                ],
                "Active",
                "#7b3294",
                "Pending",
                "#c2a5cf",
                "#9e9e9e"
              ],
              "fill-opacity": 0.7
            }
          },
          {
            "type": "line",
            "paint": {
              "line-color": "#40004b",
              "line-width": 0.8
            }
          }
        ]
      },
      "legend": {
        "type": "categorical",
        "title": "Lease status",
        "items": [
          {
            "label": "Active",
            "color": "#7b3294"
          },
          {
            "label": "Pending",
            "color": "#c2a5cf"
          }
        ]
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{site_id}: {species} ({status})"
        }
      },
      "attribution": "Maine DMR"
    },
    {
      "id": "lpa-sites",
      "title": "Limited-purpose aquaculture sites",
      "group": "Aquaculture",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_coast__lpa_sites"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "circle",
            "paint": {
              "circle-color": "#c51b7d",
              "circle-radius": 3.5,
              "circle-stroke-color": "#fff",
              "circle-stroke-width": 1
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#c51b7d",
        "label": "LPA site"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{site_id}: {species}"
        }
      },
      "attribution": "Maine DMR"
    },
    {
      "id": "boat-launches",
      "title": "Boat launches",
      "group": "Access",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.maine_coast__boat_launches"
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "symbol",
            "layout": {
              "icon-image": "poi:slipway:2166ac",
              "icon-size": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                6,
                0.45,
                10,
                0.65,
                14,
                0.9
              ],
              "icon-allow-overlap": true,
              "icon-ignore-placement": true
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#2166ac",
        "label": "Boat launch"
      },
      "interaction": {
        "inspect": true,
        "popup": {
          "template": "{water_body} ({town})"
        }
      },
      "attribution": "Maine GeoLibrary"
    },
    {
      "id": "maine-boundary",
      "title": "Maine boundary",
      "group": "Boundaries",
      "source": {
        "type": "tipg-vector",
        "collection": "pub.units__state",
        "properties": [
          "name"
        ]
      },
      "style": {
        "kind": "maplibre",
        "layers": [
          {
            "type": "line",
            "paint": {
              "line-color": "#1d3557",
              "line-width": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "zoom"
                ],
                5,
                1.2,
                12,
                2.2
              ],
              "line-opacity": 0.85
            }
          }
        ]
      },
      "legend": {
        "type": "single",
        "color": "#1d3557",
        "label": "Maine"
      },
      "interaction": {
        "inspect": false
      },
      "attribution": "U.S. Census Bureau: TIGER/Line 2024",
      "visible": true
    }
  ],
  "charts": [
    {
      "id": "shellfish",
      "title": "Shellfish growing waters by classification",
      "type": "donut",
      "layer": "shellfish-classes",
      "format": "acres",
      "data": {
        "collection": "pub.maine_coast__shellfish_classes",
        "category": "classification",
        "value": "acres",
        "agg": "sum"
      }
    }
  ]
}
