# Copy to .env with `make env` (fills the passwords with random values).
# .env is gitignored. Never commit real passwords.
#
# Passwords: use letters and digits only. They are embedded in connection URLs.

# --- Compose -----------------------------------------------------------------
# The dev overlay publishes PostGIS on 127.0.0.1:${PG_HOST_PORT} and turns on
# tiPG debug/refresh. Remove ":compose.dev.yaml" for the locked-down profile.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Production server: COMPOSE_FILE=compose.yaml:compose.prod.yaml (no dev overlay), plus the block below.

# --- Pinned versions (see docs/decisions/0001-version-pins.md) ---------------
POSTGIS_TAG=17-3.5
TIPG_TAG=1.6.1
CADDY_TAG=2.11.4-alpine
DBMATE_TAG=2.36.0
ROCKER_TAG=4.6.1

# --- Host ports ----------------------------------------------------------------
HTTP_PORT=8080
PG_HOST_PORT=5433

# --- Database ------------------------------------------------------------------
POSTGRES_DB=spatial
POSTGRES_USER=gis_owner
POSTGRES_PASSWORD=changeme

# Per-service login roles (created by migrations, passwords set by the migrator)
TIPG_DB_PASSWORD=changeme
APP_DB_PASSWORD=changeme
LOADER_DB_PASSWORD=changeme
WORKER_DB_PASSWORD=changeme
ANALYST_DB_PASSWORD=changeme
ADMIN_API_DB_PASSWORD=changeme
# MCP servers (Phase 4; docs/setup/08-mcp.md). `make mcp-credentials` adds it to an older .env.
MCP_DB_PASSWORD=changeme
# project-pipeline MCP server -> core-api (validation and field stats only). Created by make mcp-credentials.
MCP_PIPELINE_TOKEN=
# analysis MCP server -> core-api (processes and jobs only). Created by make mcp-credentials.
MCP_ANALYSIS_TOKEN=

# --- tiPG ------------------------------------------------------------------------
# Seconds before tiPG re-reads its list of pub views/functions.
# The dev overlay overrides this to 30.
TIPG_CATALOG_TTL=300

# --- Frontend (Phase 2) ----------------------------------------------------------
# glibc (Debian) on purpose: node_modules is shared with WSL and the Ubuntu-based Playwright
# image, and native packages (rolldown) install per-libc. Alpine (musl) would break them.
NODE_TAG=24.21.0-bookworm-slim
TITILER_TAG=2.4.0
PLAYWRIGHT_TAG=v1.63.0-noble

# --- Admin dashboard (/admin) ------------------------------------------------------
# HTTP basic login checked by core-api for /admin and /api/admin. `make env` randomizes it;
# `make admin-credentials` shows it (and creates it in an older .env).
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# --- External API keys (worker/geotools only; never committed) -------------------
# Census Data API (free): https://api.census.gov/data/key_signup.html
# Required by Census/ACS recipes. SSURGO/SDA, 3DEP and Earth Search need no key.
CENSUS_API_KEY=
# LANDFIRE Product Service (vegetation, fuels): every job must carry an email address. Used only for those requests.
LANDFIRE_EMAIL=

# --- Production (compose.prod.yaml; docs/setup/10-production.md) ----------------------------------------------
# Public address: a domain for automatic HTTPS (Let's Encrypt needs ports 80 and 443 reachable), or :80 to test.
SITE_ADDRESS=:80
# Contact for Let's Encrypt expiry notices.
ACME_EMAIL=
# Where the public site listens on the host (e.g. 127.0.0.1:8090 to try production mode locally next to dev).
PUBLIC_HTTP_BIND=80
PUBLIC_HTTPS_BIND=443
# Admin listener, always on the host's 127.0.0.1 (reach it with: ssh -L 8081:127.0.0.1:8081 <server>).
ADMIN_PORT=8081

# --- COGs on S3 (compose.s3.yaml; make cog-sync) -------------------------------------------------------------
COG_S3_BUCKET=spatial-cog
COG_S3_PREFIX=cog
COG_S3_REGION=us-east-1
# Leave the keys empty on EC2 with an instance role that can read (titiler) and write (cog-sync) the bucket.
COG_S3_ACCESS_KEY=
COG_S3_SECRET_KEY=
# Database backups (make backup-offsite; a nightly cron on the server, docs/setup/10-production.md)
BACKUP_S3_BUCKET=spatial-backups
BACKUP_KEEP_DAYS=30
# 1 on the server: after a successful upload, delete local dumps older than 7 days.
BACKUP_PRUNE_LOCAL=0
