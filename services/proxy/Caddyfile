{
	# Local-only proxy. In Phase 6 this role moves to CloudFront + ALB.
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# OGC API Features + Tiles. Prefix is stripped; tiPG knows it via TIPG_ROOT_PATH.
	handle_path /tiles/* {
		reverse_proxy tipg:8000
	}

	# Project manifests (Phase 2): projects/<slug>/project.json + projects/index.json,
	# served straight from the repo, so adding a project needs no rebuild.
	# Only JSON is exposed; SQL and other files in projects/ stay private.
	handle_path /projects/* {
		@notjson not path *.json
		respond @notjson 404
		root * /srv/projects
		header Cache-Control "no-cache"
		file_server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Everything else: the Svelte app (static build in the frontend container).
	handle {
		reverse_proxy frontend:80
	}
}
