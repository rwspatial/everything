{
  "manifestVersion": 1,
  "slug": "{{slug}}",
  "title": "{{title}}",
  "status": "draft",
  "description": "",
  "tags": [
    "maine"
  ],
  "view": {
    "center": [
      -69.25,
      45.3
    ],
    "zoom": 6.3,
    "basemap": "positron"
  },
  "layers": [
    {
